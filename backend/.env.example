# PQG Workspace backend environment template
# Copy to .env and fill in local runtime values.
# NEVER commit .env to source control.

# SQLite app database path. Relative paths are resolved from backend/.
DB_PATH=./app.db

# Comma-separated list of allowed local frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Hermes runtime.
# Mock mode for immediate smoke testing:
#   HERMES_DEV_MOCK=1
#
# Real Hermes mode:
#   HERMES_DEV_MOCK=0
#   HERMES_EXECUTABLE_PATH=hermes
#   HERMES_ARGS=acp
HERMES_DEV_MOCK=0
HERMES_EXECUTABLE_PATH=hermes
HERMES_ARGS=acp
HERMES_STARTUP_TIMEOUT_SECONDS=15
HERMES_REQUEST_TIMEOUT_SECONDS=60
HERMES_RESTART_BACKOFF_SECONDS=5

# Optional n8n sidecar integration. Leave empty until n8n is configured.
HERMES_N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook/
